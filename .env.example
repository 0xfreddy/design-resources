TYPESAFE_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Only set a country header overwritten by your trusted proxy. Vercel and Railway are automatic.
VISITORS_COUNTRY_HEADER=
VISITORS_REDIS_PREFIX=design-resources:visitors
# Mount a Railway volume at /data and set STACKS_FILE=/data/stacks.json in production.
STACKS_FILE=
# PostHog: the project token is public and embedded in the Vite client bundle.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
